{
  "name": "aurora-automation",
  "version": "1.0.0",
  "description": "Aurora Platform - Test Automation Suite",
  "author": "QA Team",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:login": "playwright test tests/login/",
    "test:campaigns": "playwright test tests/campaigns/",
    "test:users": "playwright test tests/users/",
    "test:settings": "playwright test tests/settings/",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:report": "playwright show-report reports/html",
    "test:trace": "playwright show-trace",
    "lint": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^25.9.1",
    "marked": "^18.0.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "winston": "^3.13.0"
  }
}
